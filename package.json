{
  "name": "photo-tag-pro",
  "version": "1.0.0",
  "description": "Photo Tag Pro workspace",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "start": "npx concurrently \"npm run start --prefix backend\" \"npm run dev --prefix frontend\"",
    "build:frontend": "npm run build --prefix frontend",
    "electron:dev": "npm run build:frontend && electron .",
    "dist:mac": "npm run build:frontend && electron-builder --mac --universal",
    "dist:mac:arm64": "npm run build:frontend && electron-builder --mac --arm64",
    "dist:mac:universal": "npm run build:frontend && electron-builder --mac --universal"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.phototagpro.app",
    "productName": "Photo Tag Pro",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "AppIcon.icns",
      "category": "public.app-category.photography",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "directories": {
      "output": "dist-electron"
    },
    "asar": true,
    "asarUnpack": [
      "backend/**",
      "**/node_modules/exiftool-vendored.pl/**",
      "**/node_modules/exiftool-vendored.exe/**"
    ],
    "files": [
      "electron/**/*",
      "backend/**/*",
      "!backend/.cache/**/*",
      "!backend/test*.*",
      "!backend/launcher*.*"
    ]
  }
}
